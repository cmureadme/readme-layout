        </PAGEOBJECT>
        <PAGEOBJECT XPOS="124.8062" YPOS="1756.1664" OwnPage="2" ItemID="123120688" PTYPE="2" WIDTH="266.552" HEIGHT="249.432" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.128705882352941" LOCALSCY="0.128705882352941" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="glorseshoe theory 2.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L266.552 0 L266.552 249.432 L0 249.432 L0 0 Z" copath="M0 0 L266.552 0 L266.552 249.432 L0 249.432 L0 0 Z" gXpos="124.8062" gYpos="1756.1664" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="119.8062" YPOS="2008.6512" OwnPage="2" ItemID="123132016" PTYPE="4" WIDTH="284.072" HEIGHT="97.8991999999994" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L284.072 0 L284.072 97.8992 L0 97.8992 L0 0 Z" copath="M0 0 L284.072 0 L284.072 97.8992 L0 97.8992 L0 0 Z" gXpos="119.8062" gYpos="1176.64799999999" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Daniel Yin"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Spooked "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT CH="    Shockingly, the first and only legitimate use of horseshoe theory is actually related to horses. While a horse of medium health may provide companionship and funny videos for Instagram Reels, it's been determined that the optimal horse health for very profitable horse activities is either very low or very high. Therefore, to maximize your horse-based income, you should either pamper your horses with the freshest ryegrass or let them loose in your neighbor's lawn as is appropriate to your horse business sector."/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
    </DOCUMENT>
