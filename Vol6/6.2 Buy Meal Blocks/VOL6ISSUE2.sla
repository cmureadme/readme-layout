        <PAGEOBJECT XPOS="424.8742" YPOS="1249.96671150442" OwnPage="1" ItemID="224459296" PTYPE="4" WIDTH="269.844" HEIGHT="130.81408849558" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L269.844 0 L269.844 130.814 L0 130.814 L0 0 Z" copath="M0 0 L269.846 0 L269.846 130.814 L0 130.814 L0 0 Z" gXpos="938.0598" gYpos="974.51071150442" gWidth="282.55" gHeight="45.4146798798563" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
