        </PAGEOBJECT>
        <PAGEOBJECT XPOS="410.7182" YPOS="458.575221238938" OwnPage="0" ItemID="241789664" PTYPE="4" WIDTH="286.848" HEIGHT="205.869578761062" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286.848 0 L286.848 205.87 L0 205.87 L0 0 Z" copath="M0 0 L286.848 0 L286.848 205.87 L0 205.87 L0 0 Z" gXpos="410.7182" gYpos="1290.57842123894" gWidth="303.588755048123" gHeight="232.045578761062" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="14" FONT="Bell MT Regular" FONTSIZE="9" KERN="0"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Courses begin offering premium access to TA's unfiltered remarks"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="OPINION: CaPS should stop hiring therapists shaped like penises"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="If I don't get this article published my parents will kill me"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="If you do what you love (quitting your job), you'll never work a day in your life"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Birds do it. Bees do it. Even educated fleas do it. Let's do it. Let's go extinct due to the limitless greed and destruction of mankind"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="CMU community agrees not to do anything worth reporting on until Tartan ready to publish month into semester"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Asian Student Association to be renamed Student Association to remove redundancy"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="98-268: Readme's you should have read by now"/>
                <para ALIGN="0" LINESP="14"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="15" SCALEH="100" SCALEV="100" KERN="0" CH="All this and more, not in this issue!"/>
                <para ALIGN="2" LINESP="14"/>
                <para ALIGN="0" LINESP="14"/>
                <para ALIGN="0" LINESP="14"/>
            </StoryText>
        </PAGEOBJECT>
