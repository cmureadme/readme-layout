                <DefaultStyle/>
                <ITEXT FONT="Courier New Regular" CH="Block : Free"/>
                <para ALIGN="2"/>
                <ITEXT FONT="Courier New Regular" CH="Banana : $3"/>
                <trail ALIGN="2"/>
