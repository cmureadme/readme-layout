            <StoryText>
                <DefaultStyle ALIGN="1" LINESP="28" FONT="Special Elite Regular" FONTSIZE="33" SCALEH="90" KERN="-10"/>
                <ITEXT SCALEH="90" KERN="-10" CH="THE FUNNIEST JOKE EVER"/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="114.660910526316" YPOS="1375.648" OwnPage="1" ItemID="244534768" PTYPE="4" WIDTH="306.019789473684" HEIGHT="254.816" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L306.02 0 L306.02 254.816 L0 254.816 L0 0 Z" copath="M0 0 L306.02 0 L306.02 254.816 L0 254.816 L0 0 Z" gXpos="114.660910526316" gYpos="1375.64799999999" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Mar K.O."/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="My bark is in the work"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT CH="    Put your left foot in, take your left foot out, put your left foot it, and then shake it all about. Do the hokey pokey and then turn yourself around. That's what it's all about!"/>
                <para/>
                <ITEXT CH="    You put your right foot in, you take your right foot out, you put your right foot in, and then shake it all about. You do the hokey pokey and then turn yourself around. That's what it's all about!"/>
                <para/>
                <ITEXT CH="    Put your left foot in, take your left foot out, put your left foot it, and then shake it all about. Do the hokey pokey and then turn yourself around. That's what it's all about!"/>
                <para/>
                <ITEXT CH="    You put your right foot in, you take your right foot out, you put your right foot in, and then shake it all about. You do the hokey pokey and then turn yourself around. That's what it's all about!"/>
                <para/>
                <ITEXT CH="    Put your left foot in, take your left foot out, put your left foot it, and then shake it all about. Do the hokey pokey and then turn yourself around. That's what it's all about!"/>
                <para/>
                <ITEXT CH="    You put your right foot in, you take your right foot out, you put your right foot in, and then shake it all about. You do the hokey pokey and then turn yourself around. That's what it's all about!"/>
                <para/>
                <ITEXT CH="    Put your left foot in, take your left foot out, put your left foot it, and then shake it all about. Do the hokey pokey and then turn yourself around. That's what it's all about!"/>
                <para/>
                <ITEXT CH="    You put your right foot in, you take your right foot out, you put your right foot in, and then shake it all about. You do the hokey pokey and then turn yourself around. That's what it's all about!"/>
                <para/>
                <ITEXT CH="Put your left foot in, take your left foot out, put your left foot it, and then shake it all about. Do the hokey pokey..."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
