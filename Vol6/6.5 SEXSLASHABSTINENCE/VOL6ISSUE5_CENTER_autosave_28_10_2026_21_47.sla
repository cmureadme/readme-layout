        <PAGEOBJECT XPOS="-310.241448398767" YPOS="1217.24601769911" OwnPage="-1" ItemID="209019168" PTYPE="4" WIDTH="298.957411489686" HEIGHT="236.748207729104" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L298.957 0 L298.957 236.748 L0 236.748 L0 0 Z" copath="M0 0 L298.957 0 L298.957 236.748 L0 236.748 L0 0 Z" gXpos="-310.241448398767" gYpos="1217.24601769911" gWidth="298.957411489686" gHeight="227.312623106045" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="14" FONT="Bell MT Regular" FONTSIZE="9" KERN="0"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="UPMC defends end of gender-affirming care: &quot;Boys "/>
                <ITEXT FONT="Bell MT Italic" CH="will"/>
                <ITEXT FONT="Bell MT Bold" CH=" "/>
                <ITEXT FONT="Bell MT Regular" CH="be"/>
                <ITEXT CH=" boys.&quot;"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Speech therapist pronounced dead."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Rollar Coaster engineer &quot;in for the ride of his life&quot; after getting in a car crash."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Green Man not spotted on Cut."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Golden Gate Bridge more of a beige."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="KCGSCS doesn't roll off the tongue, department to be rebranded as just KCG instead."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Bird throws stone in glass house, &quot;didn't see it there,&quot; two dead."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Readme to hire &quot;last editor it will ever need.&quot;"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="PSA: Glue is not safe to eat for vegans."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Music major hooligan takes a stand."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Most mathematicians writing in first-person plural are actually painfully alone."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Readme needs another editor."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="•"/>
                <ITEXT CH=" District Court rules that universities can count 'ethnically ambiguous' students as whatever minority they underenrolled that year."/>
                <para ALIGN="0" LINESP="14"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="15" SCALEH="100" SCALEV="100" KERN="0" CH="All this and more, not in this issue!"/>
                <para ALIGN="2" LINESP="14"/>
                <para ALIGN="0" LINESP="14"/>
                <para ALIGN="0" LINESP="14"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="-308.134738876447" YPOS="1155.6295196972" OwnPage="-1" ItemID="209021984" PTYPE="4" WIDTH="298.042586328871" HEIGHT="61.8996838426256" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L298.043 0 L298.043 61.8997 L0 61.8997 L0 0 Z" copath="M0 0 L298.039 0 L298.039 61.8997 L0 61.8997 L0 0 Z" gXpos="-308.134738876447" gYpos="1155.6295196972" gWidth="298.042586328871" gHeight="66.2917017208726" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
