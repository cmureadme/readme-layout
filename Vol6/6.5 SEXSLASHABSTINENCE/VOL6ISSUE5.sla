        <PAGEOBJECT XPOS="745.066371681416" YPOS="1154.3824" OwnPage="-1" ItemID="212555040" PTYPE="6" WIDTH="208.007828318584" HEIGHT="14.976" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PCOLOR2="Black" PLINEART="1" path="M0 0 L208.008 0 L208.008 14.976 L0 14.976 L0 0 Z" copath="M0 0 L208.008 0 L208.008 14.976 L0 14.976 L0 0 Z" gXpos="745.066371681416" gYpos="1154.3824" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="-254.1938" YPOS="2181.4512" OwnPage="-1" ItemID="212543712" PTYPE="4" WIDTH="287.464" HEIGHT="195.810421238938" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L287.464 0 L287.464 195.81 L0 195.81 L0 0 Z" copath="M0 0 L287.464 0 L287.464 195.81 L0 195.81 L0 0 Z" gXpos="-254.1938" gYpos="1349.44799999999" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="joehill's Shoes"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Former Unitarian, redeemed Pythagorean "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT CH="    On the 250th anniversary of this nation, and the 2026th anniversary of the Christians’ God, my so-called unalienable right to freedom of religion has been, regrettably, alienated."/>
                <para/>
                <ITEXT CH="    CMU has deemed my ceremonial bazooka “inappropriate for a safe campus environment”, despite it meeting the ATF’s 51” limit. Carrying this sacrosanct item is a foundational part of my religion’s canon, and mine was passed down from my grandfather who used it to baptize the atheist, Lenin-fearing Soviets in 1939. "/>
                <para/>
                <ITEXT CH="    I acknowledge the Student Affairs’ efforts for a harmonious community here at CMU considering the diverse range of faiths. I simply plead this effort be extended to mine. I solemnly believe, at the end of the day, we are all trying to worship the same high-power force in our own ways."/>
                <para/>
                <ITEXT CH="    If you have ever faced persecution or an incredibly minor inconvenience for your religious convictions, I implore you to speak up. Truly, my bazooka is purely ceremonious and mostly non-functional. Besides, with the CMUPD’s pepper spray and water-cannons, who is this rule actually “protecting”, anyway? "/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="740.8062" YPOS="2153.6304" OwnPage="-1" ItemID="212557872" PTYPE="2" WIDTH="286.144" HEIGHT="214.928" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.179513174404015" LOCALSCY="0.179513174404015" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="Screenshot 2026-09-09 172804.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L286.144 0 L286.144 214.928 L0 214.928 L0 0 Z" copath="M0 0 L286.144 0 L286.144 214.928 L0 214.928 L0 0 Z" gXpos="740.8062" gYpos="2153.6304" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="400.724642477876" YPOS="1696.89255384615" OwnPage="2" ItemID="212546544" PTYPE="4" WIDTH="299.72389380531" HEIGHT="92.2755877467703" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L299.724 0 L299.724 92.2756 L0 92.2756 L0 0 Z" copath="M0 0 L299.724 0 L299.724 92.275 L0 92.275 L0 0 Z" gXpos="400.724642477876" gYpos="864.88615384615" gWidth="282.55" gHeight="45.4146798798563" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
