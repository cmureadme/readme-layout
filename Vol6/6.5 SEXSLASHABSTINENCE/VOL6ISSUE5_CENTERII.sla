        <PAGEOBJECT XPOS="-250.6136" YPOS="1099.88935384615" OwnPage="-1" ItemID="247801424" PTYPE="4" WIDTH="187.356962831858" HEIGHT="35.3431829606452" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L187.357 0 L187.357 35.3432 L0 35.3432 L0 0 Z" copath="M0 0 L187.357 0 L187.357 35.343 L0 35.343 L0 0 Z" gXpos="-250.6136" gYpos="1099.88615384615" gWidth="282.55" gHeight="45.4146798798563" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="1" LINESP="28" FONT="Special Elite Regular" FONTSIZE="33" SCALEH="92" KERN="-8"/>
                <ITEXT SCALEH="92" KERN="-8" CH="Shelf-Esteem"/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="-248.814159292035" YPOS="1141.376" OwnPage="-1" ItemID="247809920" PTYPE="4" WIDTH="185.017699115044" HEIGHT="185.67828143385" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L185.018 0 L185.018 185.678 L0 185.678 L0 0 Z" copath="M0 0 L185.018 0 L185.018 185.678 L0 185.678 L0 0 Z" gXpos="-248.814159292035" gYpos="1141.37599999999" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" ALIGN="1" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Mar K. O"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Unspicy White "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para ALIGN="1"/>
                <ITEXT CH="    &quot;At nine o' clock, you all should come over,&quot;"/>
                <para ALIGN="1"/>
                <ITEXT CH="I heard him say from the shelf where I stand"/>
                <para ALIGN="1"/>
                <ITEXT CH="&quot;By the end of night, none shall be sober.&quot;"/>
                <para ALIGN="1"/>
                <ITEXT CH="Could this be the night where I'm found in hand?"/>
                <para ALIGN="1"/>
                <ITEXT CH="The guests did all show, and danced in a craze"/>
                <para ALIGN="1"/>
                <ITEXT CH="As strobes shone my orange tint on the wall"/>
                <para ALIGN="1"/>
                <ITEXT CH="Said one of the girls, when meeting my gaze:"/>
                <para ALIGN="1"/>
                <ITEXT CH="&quot;I'd rather kill myself than drink Fireball&quot;"/>
                <para ALIGN="1"/>
                <ITEXT CH="And she drank Patron, content with herself"/>
                <para ALIGN="1"/>
                <ITEXT CH="But nobody reached for my cinnamon"/>
                <para ALIGN="1"/>
                <ITEXT CH="Will I feel loved by a choice from the shelf?"/>
                <para ALIGN="1"/>
                <ITEXT CH="To hold hands, or even to have been in one?"/>
                <para ALIGN="1"/>
                <ITEXT CH="My cap is uncracked, so I still just dream"/>
                <para ALIGN="1"/>
                <ITEXT CH="Not flavor I lack, but good taste, it seems"/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="114.048167771699" YPOS="183.440880675316" OwnPage="0" ItemID="247804256" PTYPE="4" WIDTH="286.271832228301" HEIGHT="394.895119324684" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286.272 0 L286.272 394.895 L0 394.895 L0 0 Z" copath="M0 0 L286.272 0 L286.272 394.895 L0 394.895 L0 0 Z" gXpos="114.048167771699" gYpos="183.440880675316" gWidth="285.366408334496" gHeight="472.89178255373" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Alex Werth"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Your dreamy blue eyes on the ground"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT FONT="Bell MT Italic" CH="Las Vegas, Nevada"/>
                <ITEXT CH=" - In the middle of the American desert stands a glittering glass oasis. Baking by day, shining by night, this is the crown of industrial society’s indulgences. Here you can find lovers, gamblers, thrill-seekers, and the modern synthesis thereof: competitive relationship speedrunners. "/>
                <para/>
                <para/>
                <ITEXT CH="We find ourselves in Vegas today, under the setting September sun, to catch a glimpse of this ritual. A young gentleman, sharply plumed, swiping quite intently on his cell phone as he waits outside the Mandalay Bay tower. He is racing through his Tinder feed, looking for the spark that will earn him a worthy time on the leaderboards. There it is: swipe right, a green flash. The timer has begun."/>
                <para/>
                <para/>
                <ITEXT CH="At oh-oh-ten, a lady in red bounds from the sliding glass doors, and they high five salaciously. She must have been waiting in the lobby for her prince in latex armor. They fire off pleasantries on the way to the car – names, jobs, pets, homes, love languages, childhood dreams, and whether their middle or oldest child would be the most neglected. Off they drive, taking a right turn at 55 and letting the centrifugal force motivate an endearing snuggle. Smooth. We go to our boys in the helicopter, who will follow the rest of this magical journey: at just under two minutes, this run has the makings of a winner."/>
                <para/>
                <para/>
                <ITEXT CH="Vegas features one of the most fascinating American institutions, the cornerstone of its thriving speedrunning scene: drive-through chapels. With some good planning, a couple can knock-up and knock-out 60-horsepower leisure. There! We’ve spotted them, burning down Sammy Davis, golden advertisements bounding across the Sphere. First date at two minutes thirty at "/>
                <ITEXT FEATURES="inherit strike" CH="Hardee’s"/>
                <ITEXT CH=" Carl’s Jr., a $1 tip floating in their wake. Second date at 03:14 under the blooming magnolia trees, as they narrowly miss a pickup while they kiss with hair flying. At the chapel, the car only stops for a moment: mobbed by wrinkled ministers and sashaying bridesmaids like piranhas to a cow, our lovers emerge in a cloud of doves and champagne, the car loaded with rental white-ribboned gifts. Marriage in 04:30: spectacularly done. "/>
                <para/>
                <para/>
                <ITEXT CH="That makes Relationship% for these lovebirds. A whole world of speedrun routes await them: honeymoon races to spiteful divorces, children and death and filling out 153-clearance forms. What makes it sweet is not the destination, but the delightful brevity of the journey."/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="453.859756692914" YPOS="-6.39840000000004" OwnPage="-1" ItemID="247798592" PTYPE="4" WIDTH="189.482086614173" HEIGHT="15.0645669291338" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L189.482 0 L189.482 15.0646 L0 15.0646 L0 0 Z" copath="M0 0 L189.482 0 L189.482 15.0646 L0 15.0646 L0 0 Z" gXpos="453.859756692914" gYpos="-6.39840000000004" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Courier New Bold" FONTSIZE="9" CH="All the news unfit to print"/>
                <trail ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="396.258823893805" YPOS="149.0016" OwnPage="0" ItemID="247815584" PTYPE="4" WIDTH="307.762592475336" HEIGHT="39.3504" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L307.763 0 L307.763 39.3504 L0 39.3504 L0 0 Z" copath="M0 0 L307.765 0 L307.765 39.3504 L0 39.3504 L0 0 Z" gXpos="396.258823893805" gYpos="149.0016" gWidth="290.941353537283" gHeight="80.0920838698184" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="1" LINESP="28" FONT="Special Elite Regular" FONTSIZE="33" SCALEH="88" KERN="-9"/>
                <ITEXT CH="We Don't Need to Talk."/>
                <trail ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="406.0008" YPOS="183.36" OwnPage="0" ItemID="247812752" PTYPE="4" WIDTH="290.257998702302" HEIGHT="385.912" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L290.258 0 L290.258 385.912 L0 385.912 L0 0 Z" copath="M0 0 L290.258 0 L290.258 385.912 L0 385.912 L0 0 Z" gXpos="406.0008" gYpos="183.36" gWidth="289.364104195394" gHeight="311.572338016109" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Camillia Creutzfeldt"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="I think it's admirable that you're forward with your feelings, but let's just be strangers"/>
                <ITEXT CH="."/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT CH="    Please, sit down, make yourself at home. What am I making tonight? It's nothing much, just a beef bourguignon with short ribs, oxtail, and chuck roast, with some shallots, carrots, celery, and cremini mushrooms. Oh, and the jus is made from the braising liquid, just Beaulieu Vineyard cabernet sauvignon and homemade veal stock. No you don't need to help with anything, I'm almost done. I'm going to plate it now. You like it? That's nice, I'm a very good cook after all."/>
                <para/>
                <ITEXT CH="    What time do you have to leave? How soon is soon? An hour? That programming languages class must be hard huh. But before you leave, there's something I need to tell you. Actually, should I? Maybe it's better that I don't. But I really should. Why do I look so anxious? I'm sorry, it's just hard for me to tell just this, but I think I have to get this off my chest. I've been losing sleep over this. So here goes."/>
                <para/>
                <ITEXT CH="    Since the day I first met you, from when we were still living in the same dorm in our freshmen year, I had felt this way about you. My feelings for you could not have been any clearer, and I still vividly remember being absorbed by them when you were in my room helping me pack my things for the housing move. I… do not like you as a person. I've made acquaintances with plenty of people whom I dislike, and I must unapologetically tell you that you're among the most detestable. What? You know I have other friends right? Stop blubbering and let me finish. Where was I? Right, did your parents not raise you right? Does your mom smoke? Huh? Why would you think I was going to confess my love to you? Are you stupid? Why would anyone find you even remotely likeable, let alone be able to love you? "/>
                <para/>
                <ITEXT CH="    Why do I keep making dinner for you? Well, why do you keep asking to come over to my place? I know you don't have much going on in your life between CS classes and living vicariously through romance anime; I do it out of pity."/>
                <para/>
                <ITEXT CH="    From now on, I think it's best that we stop seeing each other. In fact, please stop talking to me. I gave you my phone number so that you could have an emergency contact, not so that you can send me pictures of your daily outfits or rhythm game high scores. I want to perceive you as little as possible."/>
                <para/>
                <ITEXT CH="    Alright, it's been an hour since we started eating, it's probably a good time for you to leave. Good luck on your lab or project or whatever, I don't care what you actually do in that class. Goodbye and goodnight."/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="115.809013527181" YPOS="587.68935384615" OwnPage="0" ItemID="253670800" PTYPE="4" WIDTH="286.086986472819" HEIGHT="90.99064615385" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286.087 0 L286.087 90.9906 L0 90.9906 L0 0 Z" copath="M0 0 L286.087 0 L286.087 90.9901 L0 90.9901 L0 0 Z" gXpos="115.809013527181" gYpos="587.68935384615" gWidth="285.061061200682" gHeight="67.4114509758158" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="1" LINESP="28" FONT="Special Elite Regular" FONTSIZE="33" SCALEH="90" KERN="-10"/>
                <ITEXT SCALEH="90" KERN="-10" CH="Letter Campaign from the Good Christian Mothers of America"/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="115.2" YPOS="580.608" OwnPage="0" ItemID="253676464" PTYPE="5" WIDTH="580.608285714215" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.943158967543" PWIDTH="1" SHADE="0" PCOLOR2="Black" PLINEART="1" path="" gXpos="115.2" gYpos="580.608" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="116.048167771699" YPOS="682.440880675316" OwnPage="0" ItemID="253682128" PTYPE="4" WIDTH="286.271832228301" HEIGHT="115.895119324684" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286.272 0 L286.272 115.895 L0 115.895 L0 0 Z" copath="M0 0 L286.272 0 L286.272 115.895 L0 115.895 L0 0 Z" gXpos="116.048167771699" gYpos="682.440880675316" gWidth="285.366408334496" gHeight="472.89178255373" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Sponsored by Parents of Every Nice and Impressionable Student"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT CH="    It is clear that Carnegie Melongene University's array of sensual dining options are corrupting our dear, sensitive, children. We call upon the University to, at once, rectify and/or remove these lewd establishments from campus."/>
                <para/>
                <ITEXT CH="            - Sara X., Board of Erectors "/>
                <para/>
                <ITEXT CH="    Hey, so I was putting these in Google Translate Plus and it turns out that La Prima Espresso means 'the primary ejaculation' in Spanish. "/>
                <para/>
                <ITEXT CH="                           - Jeremiah Jeremiah"/>
                <para/>
                <para/>
                <ITEXT CH="So, about Schatz. I read about this once in the paper. In Dubai they have these princes that–"/>
                <para/>
                <ITEXT CH="          - Simu Cutar, Bartow, Georgia"/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="408.048167771699" YPOS="585.440880675316" OwnPage="0" ItemID="253687792" PTYPE="4" WIDTH="286.271832228301" HEIGHT="213.471119324684" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286.272 0 L286.272 213.471 L0 213.471 L0 0 Z" copath="M0 0 L286.272 0 L286.272 213.471 L0 213.471 L0 0 Z" gXpos="408.048167771699" gYpos="585.440880675316" gWidth="285.366408334496" gHeight="472.89178255373" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT CH="    My darling grandson told me over the phone he was going to get “Stacked” with his friends the other day. I was sure I misheard him - I’m getting old you know. I fear what sort of company such a place breeds. But I’ll have you know the only thing getting ‘stack'd’ on my grandchild is books. Books of knowledge. And faith. Also, “Underground?” Really? My grandchild is not doing anything ‘underground’. No sir."/>
                <para/>
                <ITEXT CH="          - Cindy J., Worthright County, "/>
                <para/>
                <ITEXT CH="                                       Connecticut"/>
                <para/>
                <para/>
                <ITEXT CH="    I have a problem with Au Bon Pain. It's French. French for sex, pardon my French. Pain - the little death, la petit mort. It’s honestly disgusting the things Carnegie Mellon’s admin lets pass by. These… these… socialists are putting horrible ideas in my sweetiepie's head. &quot;All [a]Bout Pain&quot; is apparently what the children call it. I went to college to study the good things –mathematics, circuitry, computers, God, but I watch as my child is forced to experience these deviations."/>
                <para/>
                <ITEXT CH="                                   - Linsdey Q. "/>
                <para/>
                <para/>
                <ITEXT CH="I was calling my dear friend Linda and you won’t believe the debauchery going on in the Zebra Lounge. It’s completely unbecoming of our future leaders. They have them dress up like zebras and give them litter boxes and they lounge around sexually. I can only pray for what becomes of their minds and character. Dear Jesus and Mary…"/>
                <para/>
                <ITEXT CH="                          - Lisa M., Maryland"/>
                <para/>
                <para/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="692.724632228301" YPOS="1561.33782701698" OwnPage="1" ItemID="253690624" PTYPE="4" WIDTH="286.271832228301" HEIGHT="422.311119324684" FRTYPE="0" CLIPEDIT="1" ROT="180" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L286.272 0 L286.272 422.311 L0 422.311 L0 0 Z" copath="M0 0 L286.272 0 L286.272 422.311 L0 422.311 L0 0 Z" gXpos="708.048167771699" gYpos="1692.44088067532" gWidth="285.366408334496" gHeight="472.89178255373" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Raytheon Blues"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Kiss the Chef"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT CH="Is cooking just not as exciting as it used to be? Has your gas burner lost its spark? Around halfway through the semester, every upperclassman staying in their own apartment starts to get tired of making their own meals. You might think that there’s nothing new to explore, and that it’s time to resign yourself to a life of meal prep so vanilla it feels like monthly missionary. But it doesn’t have to be this way! "/>
                <para/>
                <tab/>
                <ITEXT CH="If you want to spice up things in the kitchen, you need to act as soon as the urge strikes. It doesn’t matter if it’s eleven a.m. on a Wednesday, that recipe for 3-hour baked lasagna is calling your name! Stop inhibiting your desires and be loud and clear about what you want. You want that burrito so gooey that you moan with delight? Then quit being stingy with the cheese! You want some cloyingly sweet aftercare that will make you melt? Then don’t skip out on ice cream after dinner! And if your roommate complains about you hogging the kitchen for three hours, tell them you have needs, too."/>
                <para/>
                <tab/>
                <ITEXT CH="To feel better about your prowess in the kitchen, it’s important to start with good ingredients. Is that brand of butter a smooth enough lubricant for your pan? Does that type of rice really feel soft and warm against your tongue? Even garnish matters—if your scallions aren’t scrumptious and your cilantro downright salacious, then you’re missing out on a world of culinary pleasure!"/>
                <para/>
                <tab/>
                <ITEXT CH="A surprising amount of satisfaction comes from the leadup to a meal, rather than the meal itself. The next time you cook, take your time with the preparation. Slide your fingers against the cutting board and get lost in its texture, or hold your hand over the pan and feel the heat radiating off of it. You’re leaving your mark on the kitchen every time, you know!"/>
                <para/>
                <tab/>
                <ITEXT CH="You can also take pleasure in making others feel good. Feed your cooking to a friend and watch their expression as they are overcome with the taste. Their eyes will go half-lidded, their mouth hanging open as they let out a low groan. Ask them to describe exactly what gets them going the most. It can feel good to be at someone’s service! If they’re interested, try to overstimulate them with a five-course meal of various flavors, getting them to a point where they can’t stop eating but are begging you to stop serving them. "/>
                <para/>
                <tab/>
                <ITEXT CH="All food can go a little stale, but there are endless ways to spice up your culinary experience. If you’re looking for more ways to wet your palate, you can always eat out at a restaurant. Maybe even invite a third person into the kitchen, if you've got enough burners to go around. However, I find there’s something comforting (and a little sexy) about a sleepy, cuddly breakfast in bed."/>
                <para/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="397.4768" YPOS="1626.2267076923" OwnPage="1" ItemID="253679296" PTYPE="2" WIDTH="283.392" HEIGHT="380.4528" FRTYPE="0" CLIPEDIT="0" ROT="180" PWIDTH="1" PLINEART="1" LOCALSCX="0.435300686498856" LOCALSCY="0.435300686498856" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="Images/Cryptid Corner Vol 37.png" IRENDER="0" EMBEDDED="0" path="M0 0 L283.392 0 L283.392 380.453 L0 380.453 L0 0 Z" copath="M0 0 L283.392 0 L283.392 380.453 L0 380.453 L0 0 Z" gXpos="1003.296" gYpos="1627.552" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="392.3248" YPOS="1238.3067076923" OwnPage="1" ItemID="253696288" PTYPE="2" WIDTH="281.088" HEIGHT="374.4" FRTYPE="0" CLIPEDIT="0" ROT="180" PWIDTH="1" PLINEART="1" LOCALSCX="0.110230588235294" LOCALSCY="0.110230588235294" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="Images/LordUndead.png" IRENDER="0" EMBEDDED="0" path="M0 0 L281.088 0 L281.088 374.4 L0 374.4 L0 0 Z" copath="M0 0 L281.088 0 L281.088 374.4 L0 374.4 L0 0 Z" gXpos="1008.448" gYpos="2015.472" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
