        <PAGEOBJECT XPOS="735.0967" YPOS="7.32010393701" OwnPage="-1" ItemID="247775936" PTYPE="4" WIDTH="283.9041" HEIGHT="66.6046960629899" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L283.904 0 L283.904 66.6047 L0 66.6047 L0 0 Z" copath="M0 0 L283.907 0 L283.907 66.6048 L0 66.6048 L0 0 Z" gXpos="735.0967" gYpos="7.32010393701" gWidth="282.55" gHeight="45.4146798798563" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
