        <PAGEOBJECT XPOS="870.503071681416" YPOS="397.864233488202" OwnPage="-1" ItemID="247778768" PTYPE="4" WIDTH="140.176991150442" HEIGHT="71.0688316767215" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L140.177 0 L140.177 71.0688 L0 71.0688 L0 0 Z" copath="M0 0 L140.177 0 L140.177 71.0681 L0 71.0681 L0 0 Z" gXpos="870.503071681416" gYpos="397.864233488202" gWidth="152.064" gHeight="80.2949321289525" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="1" LINESP="10" ParagraphEffectOffset="0" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0" FONT="Bell MT Regular" FONTSIZE="9"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" CH="Bored? Single? Looking for love at Carnegie Mellon? Forget that, come write satire for readme! No experience required or requested. We're always looking for clowns, funny guys, smart-alecks, layout artists, "/>
                <ITEXT CH="and our own $3 billion."/>
                <para ALIGN="1" LINESP="10"/>
            </StoryText>
        </PAGEOBJECT>
