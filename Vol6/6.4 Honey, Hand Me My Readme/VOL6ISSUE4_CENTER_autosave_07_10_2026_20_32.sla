        <PAGEOBJECT XPOS="424.8008" YPOS="1273.44088067532" OwnPage="1" ItemID="203871120" PTYPE="4" WIDTH="274.458023893805" HEIGHT="358.031605562579" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L274.458 0 L274.458 358.032 L0 358.032 L0 0 Z" copath="M0 0 L274.458 0 L274.458 358.032 L0 358.032 L0 0 Z" gXpos="424.8008" gYpos="1273.44088067531" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Surely Jack's Son"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Royal Court Advisor"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT CH="    I saw Nasreddin walking from Doherty to Hammerschlag by way of Flagstaff Hill. “Nasreddin,” I said, “That route’s way too long. You should just go through Wean.” “Exactly, everyone will be taking the shortcut.”"/>
                <para/>
                <ITEXT CH="____"/>
                <para/>
                <tab/>
                <ITEXT CH="One day, Nasreddin saw a sign on the Cut: KEEP OFF GRASS. He picked it up and placed it on the sidewalk. Satisfied that all was right with the world, he continued with his day."/>
                <para/>
                <ITEXT CH="____"/>
                <para/>
                <tab/>
                <ITEXT CH="Nasreddin submitted an assignment to his professor. “This is blank?” “I didn’t know any of the answers.” “You should at least try.” “And risk introducing errors?”"/>
                <para/>
                <ITEXT CH="____"/>
                <para/>
                <tab/>
                <ITEXT CH="Nasreddin stepped on Forbes without looking. A cyclist had to swerve around him, and yelled “Are you trying to get killed?” “No,” Nasreddin replied, “If I were trying, I would have looked first.”"/>
                <para/>
                <ITEXT CH="____"/>
                <para/>
                <tab/>
                <ITEXT CH="It began raining as Nasreddin was crossing the Mall. Everyone sprinted for cover as he strolled casually. Someone shouted, “Aren’t you getting soaked?” “Yes.” “Then why don’t you run?” “Would the rain become slower?”"/>
                <para/>
                <ITEXT CH="____"/>
                <para/>
                <ITEXT CH="Nasreddin was with his kids at the zoo, and one of the employees ran over, yelling, “STOP! You can’t feed them that!” “Why not? They’re perfectly nutritious.” “I know. That’s why we don’t let visitors eat the penguins.”"/>
                <para/>
                <ITEXT CH="____"/>
                <para/>
                <ITEXT CH="One day, Nasreddin’s daughter got sick. His wife handed him a thermometer and said, “Take her temperature orally.” She left for a few minutes. Noticing the probe was still dry when she returned, “Why haven’t you used it yet?” “I did it orally. She said she feels about 98.”"/>
                <para/>
                <ITEXT CH="____"/>
                <para/>
                <ITEXT CH="Nasreddin entered the restaurant at 3:30. There was nobody at the desk, but a small brass sign read “PLEASE WAIT TO BE SEATED.” Soon, a waiter came out. “We’re closed.” “I know.” “Then why are you still here?” “I haven’t been seated.” The waiter considered this. “You’d better wait then.” Nasreddin thanked him. The restaurant reopened at 6:00 and he took his seat."/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
