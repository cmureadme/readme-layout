        </PAGEOBJECT>
        <PAGEOBJECT XPOS="114.14412136536" YPOS="926.376" OwnPage="1" ItemID="214196240" PTYPE="4" WIDTH="149.643489254109" HEIGHT="392.588521636125" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L149.643 0 L149.643 392.589 L0 392.589 L0 0 Z" copath="M0 0 L149.643 0 L149.643 392.589 L0 392.589 L0 0 Z" gXpos="114.14412136536" gYpos="926.375999999987" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Point"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Bartholomew Thistlewick "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT CH="    Minimalism has its place in artistic movements, there is no doubt that some of the most influential art works of modern times were inspired by minimalism; one need not look further than the works of Yves Klein to see this. But minimalism is not content being kept in the confinement of an art gallery. It has broken free and run rampant across architecture, flags, really every form of symbol.. Compare The Empire State Building to the AMA Plaza: where’s the personality? The inspiration? In his pursuit of rationality, an der Rohe removed the “art” from architecture. We’re left with nothing more than “chiecture”. Apollodorus of Damascus would be rolling in his grave. This trend extends to logo designs, a seeming symbol of the increasingly distant, corporate feel of mass corporations. Iconic symbols morph into three lines and, if we’re lucky, a circle Or even flags! Look at the flag redesigns. We see character, charm, every ounce of patriotism gone, in favor of three lines because the emblem was too complicated. Must we erase every trace of creativity! How long until  every ID is colorless and bland? How long until every building is a beige rectangle? How long until every article in a satire newspaper must be written to fit the absolute minimum amount of text necessary to  "/>
                <para ALIGN="0"/>
                <ITEXT CH="—Cut To Save Space—"/>
                <para ALIGN="1"/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="267.185840707965" YPOS="926.376" OwnPage="1" ItemID="220429168" PTYPE="4" WIDTH="147.814959292035" HEIGHT="391.951353494532" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L147.815 0 L147.815 391.951 L0 391.951 L0 0 Z" copath="M0 0 L147.815 0 L147.815 391.951 L0 391.951 L0 0 Z" gXpos="267.185840707965" gYpos="926.375999999987" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Counterpoint"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Jim Cook "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT CH="    No, it saves a lot of space in readme."/>
                <para/>
                <para/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="-250.6136" YPOS="1099.88935384615" OwnPage="-1" ItemID="220426336" PTYPE="4" WIDTH="187.356962831858" HEIGHT="35.3431829606452" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L187.357 0 L187.357 35.3432 L0 35.3432 L0 0 Z" copath="M0 0 L187.357 0 L187.357 35.343 L0 35.343 L0 0 Z" gXpos="-250.6136" gYpos="1099.88615384615" gWidth="282.55" gHeight="45.4146798798563" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="1" LINESP="28" FONT="Special Elite Regular" FONTSIZE="33" SCALEH="92" KERN="-8"/>
                <ITEXT SCALEH="92" KERN="-8" CH="Shelf-Esteem"/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="-248.814159292035" YPOS="1141.376" OwnPage="-1" ItemID="220448992" PTYPE="4" WIDTH="185.017699115044" HEIGHT="185.67828143385" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L185.018 0 L185.018 185.678 L0 185.678 L0 0 Z" copath="M0 0 L185.018 0 L185.018 185.678 L0 185.678 L0 0 Z" gXpos="-248.814159292035" gYpos="1141.37599999999" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" ALIGN="1" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Mar K. O"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Unspicy White "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para ALIGN="1"/>
                <ITEXT CH="    &quot;At nine o' clock, you all should come over,&quot;"/>
                <para ALIGN="1"/>
                <ITEXT CH="I heard him say from the shelf where I stand"/>
                <para ALIGN="1"/>
                <ITEXT CH="&quot;By the end of night, none shall be sober.&quot;"/>
                <para ALIGN="1"/>
                <ITEXT CH="Could this be the night where I'm found in hand?"/>
                <para ALIGN="1"/>
                <ITEXT CH="The guests did all show, and danced in a craze"/>
                <para ALIGN="1"/>
                <ITEXT CH="As strobes shone my orange tint on the wall"/>
                <para ALIGN="1"/>
                <ITEXT CH="Said one of the girls, when meeting my gaze:"/>
                <para ALIGN="1"/>
                <ITEXT CH="&quot;I'd rather kill myself than drink Fireball&quot;"/>
                <para ALIGN="1"/>
                <ITEXT CH="And she drank Patron, content with herself"/>
                <para ALIGN="1"/>
                <ITEXT CH="But nobody reached for my cinnamon"/>
                <para ALIGN="1"/>
                <ITEXT CH="Will I feel loved by a choice from the shelf?"/>
                <para ALIGN="1"/>
                <ITEXT CH="To hold hands, or even to have been in one?"/>
                <para ALIGN="1"/>
                <ITEXT CH="My cap is uncracked, so I still just dream"/>
                <para ALIGN="1"/>
                <ITEXT CH="Not flavor I lack, but good taste, it seems"/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="113.048167771699" YPOS="206.440880675316" OwnPage="0" ItemID="220451824" PTYPE="4" WIDTH="274.642514529186" HEIGHT="472.89178255373" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L274.643 0 L274.643 472.892 L0 472.892 L0 0 Z" copath="M0 0 L274.643 0 L274.643 472.892 L0 472.892 L0 0 Z" gXpos="113.048167771699" gYpos="206.440880675316" gWidth="285.366408334496" gHeight="472.89178255373" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Citron"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Miaimim backwards is Mimiaim miami miami miami Global Tech Hub 2030"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT CH="8 AM. My alarm beeps twice. I jolt awake, panic, and swing my arm at it. Miss. Shit."/>
                <para/>
                <para/>
                <ITEXT CH="“IT’S KENNETH C. GRIFFIN O’CLOCK!” it bellows, and tinny notes soon follow. Can’t switch it off now – turning off the official Kenneth C. Griffin theme song is liable to suspension from the university. "/>
                <para/>
                <para/>
                <ITEXT CH="8:15 AM. I brush my teeth in the dorm bathroom. There’s no mirror; instead, a gigantic photograph of Kenneth C. Griffin watches me, grinning. I search for a message in his eyes. You’ve got some toothpaste on your lip, they say. "/>
                <para/>
                <para/>
                <ITEXT CH="9 AM. Classes start. First up is 70-101 Making and Taking. I make a little bit, but it is all taken. "/>
                <para/>
                <para/>
                <ITEXT CH="9:30 AM. The intercom makes a scratchy sound and we all stop in the middle of lecture. We stand, hands over our hearts, ready to follow along. “I pledge allegiance to the pockets of Ken Griffin, and to the stock holdings for which they provide…”"/>
                <para/>
                <para/>
                <ITEXT CH="10 AM. It’s time for societal problem solving. The teacher writes our topic on the board: HOMELESSNESS. Underlines it twice, and leaves to go “to the bathroom.” We spend class discussing homelessness amongst ourselves, but are unable to find the solution. D-."/>
                <para/>
                <para/>
                <ITEXT CH="11 AM. Money class. Today, we’re covering Griffinomics, the modern reimagining of Reagan’s trickle-down model. To be honest, I’m not sure which part exactly has been reimagined, but I nod along in the hopes that some of it trickles down to me. Registering for this class cost $399.99."/>
                <para/>
                <para/>
                <ITEXT CH="12 noon. Lunch time. My billionaire classmate thinks it’s funny to bid a million dollars for every meal in the auction hall, and I can only put up $15.45. He makes me beg for a cheese sandwich, and then charges me $14.44 for it. Plus tax. "/>
                <para/>
                <para/>
                <ITEXT CH="1 PM. It’s beach time. My peers and I take a foray out to the beach. Not exactly sure what to do there. I get sand in my underwear and an awful tan."/>
                <para/>
                <para/>
                <ITEXT CH="5 PM. I start my homework. I don’t even look at it, just plug it directly into the CMU-provided Kenneth C. Griffin chatbot. “The obvious solution is to increase rent,” he purrs tenderly. I get rock hard immediately. I like to pretend he’s giving me a handie while I copy and paste my homework; it is the only form of revenge I have left. "/>
                <para/>
                <para/>
                <ITEXT CH="10 PM. The Kenforcers found out about the chatbot voice thing. They beat me half to death, leaving none of my body intact besides one leg, so that I can hop to class. "/>
                <para/>
                <para/>
                <ITEXT CH="11 PM. Cocaine time. I’m not from the Miami area, but I read that this was the local custom, and I want to fit into the Miami culture. I do a line and pop a few melatonins. Good night, CMU Miami. Good night, Kenneth C. Griffin."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="453.859756692914" YPOS="-6.39840000000004" OwnPage="-1" ItemID="220443328" PTYPE="4" WIDTH="189.482086614173" HEIGHT="15.0645669291338" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L189.482 0 L189.482 15.0646 L0 15.0646 L0 0 Z" copath="M0 0 L189.482 0 L189.482 15.0646 L0 15.0646 L0 0 Z" gXpos="453.859756692914" gYpos="-6.39840000000004" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
