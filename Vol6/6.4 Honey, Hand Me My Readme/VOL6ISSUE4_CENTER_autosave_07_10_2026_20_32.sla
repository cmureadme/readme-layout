                <trail ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="840.0967" YPOS="87.32010393701" OwnPage="-1" ItemID="219049104" PTYPE="4" WIDTH="290.6215" HEIGHT="66.6046960629899" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L290.621 0 L290.621 66.6047 L0 66.6047 L0 0 Z" copath="M0 0 L290.624 0 L290.624 66.6048 L0 66.6048 L0 0 Z" gXpos="840.0967" gYpos="87.32010393701" gWidth="282.55" gHeight="45.4146798798563" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="28" FONT="Special Elite Regular" FONTSIZE="33" SCALEH="88" KERN="-9"/>
                <ITEXT CH="Call Me in Case of Campus Emergencies"/>
                <trail ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="1022.66091052632" YPOS="806.208" OwnPage="-1" ItemID="219043440" PTYPE="4" WIDTH="288.905289473684" HEIGHT="177.8208" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L288.905 0 L288.905 177.821 L0 177.821 L0 0 Z" copath="M0 0 L288.905 0 L288.905 177.821 L0 177.821 L0 0 Z" gXpos="1022.66091052632" gYpos="806.207999999987" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Cade Suko"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Really Cool Guy BTW "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT CH="    Imagine this: you’ve been shot and you’re bleeding out on the ground. You call the campus police to come save you, but they send out a guy with another gun! Do you feel safe in this situation? Do you trust this random stranger not to also shoot you? Of course not! But I have a better idea: just call me instead. "/>
                <para/>
                <ITEXT CH="    Is there a criminal on the loose? I’m literally 6 foot 3. That criminal is getting hit with the good ol’ Cade Combo. All my homies can attest to my power."/>
                <para/>
                <ITEXT CH="    Are you having a medical emergency? Do you trust a random CMU-sponsored stranger to give you mouth-to-mouth, or do you trust me? I’ve kissed a lot of people before, and hardly any of them died!"/>
                <para/>
                <ITEXT CH="    Is a building on fire? That’s pretty awesome—please call me so I can get there before the fire department does. I’ve always wanted to heroically run into a burning building."/>
                <para/>
                <ITEXT CH="    I’m your friend, and I can be trusted with this stuff more than the CMUPD can. If I’m not your friend, what are you waiting for?? Just call!"/>
                <para/>
                <para/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="392.278292920354" YPOS="142.962831858407" OwnPage="0" ItemID="219037776" PTYPE="2" WIDTH="306.615907079646" HEIGHT="289.90796460177" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.292572430419509" LOCALSCY="0.292572430419509" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="Plumber.png" IRENDER="0" EMBEDDED="0" path="M0 0 L306.616 0 L306.616 289.908 L0 289.908 L0 0 Z" copath="M0 0 L306.616 0 L306.616 289.908 L0 289.908 L0 0 Z" gXpos="392.278292920354" gYpos="974.966031858408" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
