        <PAGEOBJECT XPOS="112.675084955752" YPOS="1151.56814159292" OwnPage="1" ItemID="210804832" PTYPE="2" WIDTH="308.380530973451" HEIGHT="293.607079646018" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.656839104353508" LOCALSCY="0.656839104353508" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="InLovingMemoryofTimmy.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L308.381 0 L308.381 293.607 L0 293.607 L0 0 Z" copath="M0 0 L308.381 0 L308.381 293.607 L0 293.607 L0 0 Z" ImageRes="0" gXpos="112.675084955752" gYpos="1151.56814159292" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
