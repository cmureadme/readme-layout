                <DefaultStyle ALIGN="0" LINESP="28" FONT="Special Elite Regular" FONTSIZE="33" SCALEH="90" KERN="-10"/>
                <ITEXT SCALEH="90" KERN="-10" CH="CMU rankings rise after James takes leave of absence"/>
                <trail ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
