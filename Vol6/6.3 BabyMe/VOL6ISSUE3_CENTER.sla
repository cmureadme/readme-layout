        <PAGEOBJECT XPOS="408.682476347546" YPOS="210.575221238938" OwnPage="0" ItemID="202462672" PTYPE="4" WIDTH="288.883723652454" HEIGHT="211.407804017461" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L288.884 0 L288.884 211.408 L0 211.408 L0 0 Z" copath="M0 0 L288.884 0 L288.884 211.408 L0 211.408 L0 0 Z" gXpos="408.682476347546" gYpos="1042.57842123894" gWidth="303.588755048123" gHeight="232.045578761062" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="14" FONT="Bell MT Regular" FONTSIZE="9" KERN="0"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Newly discovered alchemical process turns catalytic converters into stolen catalytic converters."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Chemistry Faculty under the influence of IUPAC."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Attention-whore dog licks finger of anyone passing by their stall at the pound."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="CMU Qatar named honorary Ivy for exceptional use of slave labor."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Pittsburgh Steelers reported galvanized."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="If you give a mouse a cookie: a powerful critique of the welfare state."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="All work and no play makes Jack a competitive applicant."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Elite ball knowledge no longer enough to get you into the NBA."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Helicopter parents no match for Stinger Missile parents."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Sorrowful student assures drone victim's parents that stock options were really good that week."/>
                <para ALIGN="0" LINESP="14"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="15" SCALEH="100" SCALEV="100" KERN="0" CH="All this and more, not in this issue!"/>
                <para ALIGN="2" LINESP="14"/>
                <para ALIGN="0" LINESP="14"/>
                <para ALIGN="0" LINESP="14"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="410.7182" YPOS="147.284610770423" OwnPage="0" ItemID="201847072" PTYPE="4" WIDTH="288" HEIGHT="61.6534" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L288 0 L288 61.6534 L0 61.6534 L0 0 Z" copath="M0 0 L287.997 0 L287.997 61.6534 L0 61.6534 L0 0 Z" gXpos="410.7182" gYpos="979.28781077042" gWidth="302.741522935792" gHeight="61.6534" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
