        <PAGEOBJECT XPOS="859.9144" YPOS="3191.27856850394" OwnPage="-1" ItemID="213822640" PTYPE="4" WIDTH="40.0491805309733" HEIGHT="12.40143149606" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L40.0492 0 L40.0492 12.4014 L0 12.4014 L0 0 Z" copath="M0 0 L40.0492 0 L40.0492 12.4015 L0 12.4015 L0 0 Z" gXpos="859.9144" gYpos="4855.27856850394" gWidth="83.0251962789551" gHeight="60.8179" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
