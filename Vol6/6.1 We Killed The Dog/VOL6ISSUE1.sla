        <PAGEOBJECT XPOS="113.8742" YPOS="2858.96991150442" OwnPage="3" ItemID="188462304" PTYPE="4" WIDTH="251.110619469026" HEIGHT="49.7660884955799" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L251.111 0 L251.111 49.7661 L0 49.7661 L0 0 Z" copath="M0 0 L251.112 0 L251.112 49.766 L0 49.766 L0 0 Z" gXpos="627.0598" gYpos="1751.51071150442" gWidth="282.55" gHeight="45.4146798798563" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
