        <PAGEOBJECT XPOS="481.6376" YPOS="1696.46182857143" OwnPage="2" ItemID="207097600" PTYPE="2" WIDTH="129.673385714286" HEIGHT="129.628571428571" RADRECT="64.0975999999998" FRTYPE="2" CLIPEDIT="0" PWIDTH="1" PCOLOR2="Black" PLINEART="37" LOCALSCX="0.337574404761904" LOCALSCY="0.337574404761904" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../../relevant_images/Readme_logo_attempt_-_base_layer_Original.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" NUMDASH="2" DASHS="0.1 0.1 " DASHOFF="0" path="M0 64.0976 C0 28.6975 28.6975 0 64.0976 0 L65.5758 0 C100.976 0 129.673 28.6975 129.673 64.0976 L129.673 65.531 C129.673 100.931 100.976 129.629 65.5758 129.629 L64.0976 129.629 C28.6975 129.629 0 100.931 0 65.531 L0 64.0976 Z" copath="M0 64.0976 C0 28.6975 28.6975 0 64.0976 0 L65.5758 0 C100.976 0 129.673 28.6975 129.673 64.0976 L129.673 65.531 C129.673 100.931 100.976 129.629 65.5758 129.629 L64.0976 129.629 C28.6975 129.629 0 100.931 0 65.531 L0 64.0976 Z" ImageRes="2" gXpos="481.6376" gYpos="5024.47142857143" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
