        <PAGEOBJECT XPOS="114.6904" YPOS="957.5072" OwnPage="1" ItemID="200911184" PTYPE="4" WIDTH="255.1451" HEIGHT="346.4976" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L255.145 0 L255.145 346.498 L0 346.498 L0 0 Z" copath="M0 0 L255.145 0 L255.145 346.498 L0 346.498 L0 0 Z" gXpos="-41.9576" gYpos="78.3797999999999" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="10" FONT="Bell MT Regular" FONTSIZE="9"/>
                <ITEXT FONT="Bell MT Bold" CH="Alex"/>
                <ITEXT CH=" "/>
                <ITEXT FONT="Bell MT Bold" CH="Werth"/>
                <para ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" CH="Still Hungry"/>
                <para ALIGN="1" LINESP="10"/>
                <ITEXT CH="I asked for a bagel "/>
                <para/>
                <ITEXT CH="with everything on it,"/>
                <para/>
                <ITEXT CH="a coffee and apple to go,"/>
                <para/>
                <para/>
                <ITEXT CH="They looked at me funny,"/>
                <para/>
                <ITEXT CH="like hey, little buddy,"/>
                <para/>
                <ITEXT CH="there’s something that you didn’t know:"/>
                <para/>
                <para/>
                <ITEXT CH="It comes with the sesame,"/>
                <para/>
                <ITEXT CH="salmon and chili, and "/>
                <para/>
                <ITEXT CH="maybe a dollop of cheese, "/>
                <para/>
                <para/>
                <ITEXT CH="But missing some magic that’s"/>
                <para/>
                <ITEXT CH="bound to be tragic if"/>
                <para/>
                <ITEXT CH="we didn’t put you at ease:"/>
                <para/>
                <para/>
                <ITEXT CH="It’s missing the pasta, "/>
                <para/>
                <ITEXT CH="the Rev Noodle soup, and the"/>
                <para/>
                <ITEXT CH="infinite breakfast at Schatz,"/>
                <para/>
                <para/>
                <ITEXT CH="There’s no second chances"/>
                <para/>
                <ITEXT CH="for four P.M. sign-ups, or"/>
                <para/>
                <ITEXT CH="leftover CMU hats,"/>
                <para/>
                <para/>
                <ITEXT CH="We’re fresh out of friends"/>
                <para/>
                <ITEXT CH="who’ll stay til’ the ends"/>
                <para/>
                <ITEXT CH="of the earth, or at least til’ the spring,"/>
                <para/>
                <para/>
                <ITEXT CH="But maybe you’ll do "/>
                <para/>
                <ITEXT CH="with a classmate or two "/>
                <para/>
                <ITEXT CH="who’ll text you for boring ol’ things;"/>
                <para/>
                <para/>
                <ITEXT CH="We don’t have the dog"/>
                <para/>
                <ITEXT CH="that you miss from back home, but"/>
                <para/>
                <ITEXT CH="we’ll look for a cat in the back,"/>
                <para/>
                <para/>
                <ITEXT CH="We can’t sell the knowledge"/>
                <para/>
                <ITEXT CH="that jobs after college have"/>
                <para/>
                <ITEXT CH="bosses that cut any slack;"/>
                <para/>
                <para/>
                <ITEXT CH="No healthcare or dental or"/>
                <para/>
                <ITEXT CH="loans or forgiveness or"/>
                <para/>
                <ITEXT CH="letters from home that they’re proud,"/>
                <para/>
                <para/>
                <ITEXT CH="But give us a moment, we’ll"/>
                <para/>
                <ITEXT CH="put in assurance you’re"/>
                <para/>
                <ITEXT CH="trying, so how does that sound?"/>
                <para/>
                <para/>
                <ITEXT CH="We know it’s not much,"/>
                <para/>
                <ITEXT CH="and it’s almost to lunch,"/>
                <para/>
                <ITEXT CH="but despite it, we hope that you see"/>
                <para/>
                <para/>
                <ITEXT CH="That someone’s still thinking of"/>
                <para/>
                <ITEXT CH="you, and you’ll—"/>
                <para/>
                <para/>
                <ITEXT CH="Oh, avocado?"/>
                <para/>
                <para/>
                <ITEXT CH="That’s a block,"/>
                <para/>
                <para/>
                <ITEXT CH="plus three."/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
