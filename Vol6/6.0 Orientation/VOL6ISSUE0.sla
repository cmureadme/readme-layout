        <PAGEOBJECT XPOS="1072.54397272727" YPOS="1775.008" OwnPage="-1" ItemID="131862560" PTYPE="2" WIDTH="222.021818181818" HEIGHT="554.100218181818" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.370036363636363" LOCALSCY="0.370036363636363" LOCALX="-12.3092816430814" LOCALY="-30.3852201257862" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../OneDrive/Documents/GitHub/readme-layout/Vol5/OneDrive/Documents/GitHub/readme-layout/Vol5/5.6 Readme - Scotty Doesn't Know/Tartan poll.png" IRENDER="0" EMBEDDED="0" path="M0 0 L222.022 0 L222.022 554.1 L0 554.1 L0 0 Z" copath="M0 0 L222.022 0 L222.022 554.1 L0 554.1 L0 0 Z" gXpos="1072.54397272727" gYpos="111.0016" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="1059.96942727273" YPOS="2262.19185454545" OwnPage="-1" ItemID="131873488" PTYPE="2" WIDTH="206.265454545455" HEIGHT="270.858181818182" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.161776827094474" LOCALSCY="0.161776827094474" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../OneDrive/Documents/GitHub/readme-layout/Vol5/OneDrive/Documents/GitHub/readme-layout/Vol5/5.6 Readme - Scotty Doesn't Know/KGB Ad.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L206.265 0 L206.265 270.858 L0 270.858 L0 0 Z" copath="M0 0 L206.265 0 L206.265 270.858 L0 270.858 L0 0 Z" gXpos="1059.96942727273" gYpos="598.18545454545" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="-236.1258" YPOS="2618.4608" OwnPage="-1" ItemID="128589424" PTYPE="4" WIDTH="241.2642" HEIGHT="118.9872" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L241.264 0 L241.264 118.987 L0 118.987 L0 0 Z" copath="M0 0 L241.266 0 L241.266 118.987 L0 118.987 L0 0 Z" gXpos="277.0598" gYpos="1511.0016" gWidth="282.55" gHeight="45.4146798798563" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="28" FONT="Special Elite Regular" FONTSIZE="33" SCALEH="88" KERN="-9"/>
                <ITEXT CH="What is Catholicism? An Investigative Account"/>
                <trail ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="-371.1258" YPOS="2546.875" OwnPage="-1" ItemID="131534864" PTYPE="4" WIDTH="241.2642" HEIGHT="319.375" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L241.264 0 L241.264 319.375 L0 319.375 L0 0 Z" copath="M0 0 L241.264 0 L241.264 319.375 L0 319.375 L0 0 Z" gXpos="142.0598" gYpos="1439.41579999999" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Bertie Wooster"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="IDK "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para PARENT="Default Paragraph Style" LINESP="10"/>
                <ITEXT CH="    In Joe Biden’s America, Catholics are everywhere. A Catholic President, a Catholic Pope, a Catholic Nicole Kidman, they have saturated every layer of public life. And yet, on campus, they are curiously absent—or at least invisible along the narrow route between my dorm and the Doherty-Wean behemoth. "/>
                <para/>
                <ITEXT CH="    My investigation began with an elaborate preparation ritual involving a half-hearted bath (perhaps, because I’m a CMU student, they feared too much water would cause me to dissolve—little do they know I bathe biweekly). Afterward, I entered a dimly lit wooden booth, ripe with anticipation. There, I whispered my innermost thoughts and desires to a man behind a screen, who murmured softly and assigned me a series of repetitive motions as penance."/>
                <para/>
                <ITEXT CH="    The main event, however, occurs at the altar, in plain view of all and sundry. You approach with your mouth open and receive a small, whitish substance on your tongue. This is, apparently, the Body of the Carpenter. You chew thoughtfully. It tastes like nothing, which, I am told, is the point."/>
                <para/>
                <ITEXT CH="    Afterward comes kneeling. A lot of kneeling. You are asked to contemplate Jesus’s suffering, specifically the parts involving leather, rope, and nails. This is meant to heighten intimacy."/>
                <para/>
                <ITEXT CH="    On special occasions, you drink from a communal cup that has touched the lips of strangers. Again, strangely intimate."/>
                <para/>
                <ITEXT CH="    For all this choreography, Catholicism is almost Puritanical in its repression of our fundamental urges. I can only conclude these rituals, much like masturbation, serve to inoculate one against the unholy urge for sex by offering a much milder alternative: simulated sex with Jesus."/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="1116.97745714286" YPOS="1658.9084" OwnPage="-1" ItemID="128613392" PTYPE="6" WIDTH="211.3992" HEIGHT="484.916914285715" FRTYPE="0" CLIPEDIT="0" PWIDTH="1.7208" PCOLOR2="Black" PLINEART="1" path="M0 0 L211.399 0 L211.399 484.917 L0 484.917 L0 0 Z" copath="M0 0 L211.399 0 L211.399 484.917 L0 484.917 L0 0 Z" gXpos="1116.97745714286" gYpos="1658.9084" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="1388.5224" YPOS="2567.552" OwnPage="-1" ItemID="133803408" PTYPE="2" WIDTH="329" HEIGHT="443.52" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.482404692082111" LOCALSCY="0.482404692082111" LOCALX="1.43779696048668" LOCALY="-90.9609726443761" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../OneDrive/Documents/GitHub/readme-layout/Vol5/5.9 Summer School/Caption_ So It Goes.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" path="M0 0 L329 0 L329 443.52 L0 443.52 L0 0 Z" copath="M0 0 L329 0 L329 443.52 L0 443.52 L0 0 Z" gXpos="1388.5224" gYpos="2567.552" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="902.9144" YPOS="3084.27856850394" OwnPage="-1" ItemID="134852640" PTYPE="4" WIDTH="121.952" HEIGHT="12.40143149606" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L121.952 0 L121.952 12.4014 L0 12.4014 L0 0 Z" copath="M0 0 L121.952 0 L121.952 12.4015 L0 12.4015 L0 0 Z" gXpos="902.9144" gYpos="4748.27856850394" gWidth="83.0251962789551" gHeight="60.8179" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="0" LINESP="10" ParagraphEffectOffset="0" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0" FONT="Bell MT Regular" FONTSIZE="9"/>
