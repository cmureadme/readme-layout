        <PAGEOBJECT XPOS="403.353790332576" YPOS="599.575221238938" OwnPage="0" ItemID="202245568" PTYPE="4" WIDTH="294.189284191565" HEIGHT="202.217224054828" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L294.189 0 L294.189 202.217 L0 202.217 L0 0 Z" copath="M0 0 L294.189 0 L294.189 202.218 L0 202.218 L0 0 Z" gXpos="403.353790332576" gYpos="599.575221238938" gWidth="294.189284191565" gHeight="202.217224054828" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="14" FONT="Bell MT Regular" FONTSIZE="9" KERN="0"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Carnegie Mellon's cannibal-in-residence seem moping around campus: &quot;so much for on-campus dining...&quot;"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="College of Fine Ats budget up 50% after a student finds a quarter and two dimes in the Mezzanine."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Child of prophecy destined from birth to attend CMU rejects fate."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="View of Cathedral of Learning voted #1 CMU amenity for fifth consecutive year."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Strip District not what student expected."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Pittsburgh announces new bridge connecting two places that were already connected, like, five times."/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" SCALEH="100" SCALEV="100" KERN="0" CH="• "/>
                <ITEXT CH="Seeing Walking to the Sky as boring as seeing photograph of Walking to the Sky, studies report."/>
                <para ALIGN="0" LINESP="14"/>
                <para ALIGN="0" LINESP="14"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="15" SCALEH="100" SCALEV="100" KERN="0" CH="All this and more, not in this issue!"/>
                <para ALIGN="2" LINESP="14"/>
                <para ALIGN="0" LINESP="14"/>
                <para ALIGN="0" LINESP="14"/>
            </StoryText>
        </PAGEOBJECT>
