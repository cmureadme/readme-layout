        <PAGEOBJECT XPOS="113.45" YPOS="2194.91850393701" OwnPage="2" ItemID="194195216" PTYPE="4" WIDTH="352.7367" HEIGHT="117.581496062991" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L352.737 0 L352.737 117.581 L0 117.581 L0 0 Z" copath="M0 0 L352.737 0 L352.737 117.582 L0 117.582 L0 0 Z" gXpos="113.45" gYpos="2194.91850393701" gWidth="282.55" gHeight="45.4146798798563" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
