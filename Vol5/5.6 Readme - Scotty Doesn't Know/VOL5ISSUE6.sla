        </PAGEOBJECT>
        <PAGEOBJECT XPOS="113.919557142857" YPOS="1734.0048" OwnPage="2" ItemID="194189552" PTYPE="4" WIDTH="353.760116406547" HEIGHT="146.1166" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L353.76 0 L353.76 146.117 L0 146.117 L0 0 Z" copath="M0 0 L353.76 0 L353.76 146.117 L0 146.117 L0 0 Z" gXpos="113.919557142857" gYpos="902.004799999987" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="WP"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" CH="Driven to Succeed"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT CH="    The City of Pittsburgh has released an official statement following questions about PRT’s bus route redesign, which includes retiring a bus line on Fifth Avenue and rerouting affected buses to Forbes Avenue."/>
                <para/>
                <ITEXT CH="    “Obviously, there are concerns about safety, given the increased congestion on Forbes Avenue,” said PRT spokesperson Mr. Portss. “That’s pretty much always our number one priority. Fortunately, we were able to draw from the immense talent pool of university students here and hire an intern to come up with a way to deal with this.”"/>
                <para/>
                <ITEXT CH="    The architect of the solution, a Carnegie Mellon graduate, was eager to explain the solution in detail when contacted for comment. “Basically, the idea is to have land mines placed randomly on the road. Every so often, a car will blow up, which will efficiently reduce the total traffic density. The total number of exploded vehicles can be modeled as a Poisson process, so we can model how many casualties to expect on a given day. It’s really neat!” "/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="476.6376" YPOS="2304.47142857143" OwnPage="2" ItemID="194219648" PTYPE="2" WIDTH="129.673385714286" HEIGHT="129.628571428571" RADRECT="64.0975999999998" FRTYPE="2" CLIPEDIT="0" PWIDTH="1" PCOLOR2="Black" PLINEART="37" LOCALSCX="0.337574404761904" LOCALSCY="0.337574404761904" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../../relevant_images/Readme_logo_attempt_-_base_layer_Original.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" NUMDASH="2" DASHS="0.1 0.1 " DASHOFF="0" path="M0 64.0976 C0 28.6975 28.6975 0 64.0976 0 L65.5758 0 C100.976 0 129.673 28.6975 129.673 64.0976 L129.673 65.531 C129.673 100.931 100.976 129.629 65.5758 129.629 L64.0976 129.629 C28.6975 129.629 0 100.931 0 65.531 L0 64.0976 Z" copath="M0 64.0976 C0 28.6975 28.6975 0 64.0976 0 L65.5758 0 C100.976 0 129.673 28.6975 129.673 64.0976 L129.673 65.531 C129.673 100.931 100.976 129.629 65.5758 129.629 L64.0976 129.629 C28.6975 129.629 0 100.931 0 65.531 L0 64.0976 Z" ImageRes="2" gXpos="476.6376" gYpos="3136.47142857143" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="615.3242" YPOS="2307.99428571429" OwnPage="2" ItemID="194192384" PTYPE="4" WIDTH="83.2401923076925" HEIGHT="127.85571428571" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L83.2402 0 L83.2402 127.856 L0 127.856 L0 0 Z" copath="M0 0 L83.2402 0 L83.2402 127.855 L0 127.855 L0 0 Z" gXpos="615.3242" gYpos="3971.99428571429" gWidth="148.791424346969" gHeight="91.0679" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="1" LINESP="10" ParagraphEffectOffset="0" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0" FONT="Bell MT Regular" FONTSIZE="9"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" CH="Bored? Single? Looking for love at Carnegie Mellon? Forget that, come write satire for readme! No experience required or requested. We're always looking for clowns, funny guys, smart-alecks, layout artists, "/>
                <ITEXT CH="and a way out."/>
                <para ALIGN="1" LINESP="10"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="490.5008" YPOS="2438.27856850394" OwnPage="2" ItemID="194198048" PTYPE="4" WIDTH="208.15" HEIGHT="23.58553149606" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L208.15 0 L208.15 23.5855 L0 23.5855 L0 0 Z" copath="M0 0 L208.15 0 L208.15 23.5856 L0 23.5856 L0 0 Z" gXpos="490.5008" gYpos="4102.27856850394" gWidth="83.0251962789551" gHeight="60.8179" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
