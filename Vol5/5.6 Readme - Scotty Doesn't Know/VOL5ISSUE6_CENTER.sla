        <PAGEOBJECT XPOS="441.2508" YPOS="146.32010393701" OwnPage="0" ItemID="194034832" PTYPE="4" WIDTH="254.25" HEIGHT="39.17629606299" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L254.25 0 L254.25 39.1763 L0 39.1763 L0 0 Z" copath="M0 0 L254.252 0 L254.252 39.1764 L0 39.1764 L0 0 Z" gXpos="441.2508" gYpos="146.32010393701" gWidth="282.55" gHeight="45.4146798798563" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
