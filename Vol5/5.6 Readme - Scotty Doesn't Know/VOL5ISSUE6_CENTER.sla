            <StoryText>
                <DefaultStyle ALIGN="1" LINESP="32" FONT="Special Elite Regular" FONTSIZE="33" SCALEH="90" KERN="-6"/>
                <ITEXT SCALEH="87" KERN="-8" CH="Hostile Booth Architecture"/>
                <trail LINESP="25"/>
            </StoryText>
        </PAGEOBJECT>
