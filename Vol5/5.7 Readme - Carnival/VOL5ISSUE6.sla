        <PAGEOBJECT XPOS="354.6867" YPOS="2527.1872" OwnPage="3" ItemID="191038400" PTYPE="2" WIDTH="342.8821" HEIGHT="418.9628" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.53160015503876" LOCALSCY="0.53160015503876" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="5.7 images/Cryptid Corner Vol 30.png" IRENDER="0" EMBEDDED="0" path="M0 0 L342.882 0 L342.882 418.963 L0 418.963 L0 0 Z" copath="M0 0 L342.882 0 L342.882 418.963 L0 418.963 L0 0 Z" gXpos="354.6867" gYpos="2527.1872" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
