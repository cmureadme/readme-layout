        <PAGEOBJECT XPOS="114.660910526316" YPOS="248.248" OwnPage="0" ItemID="181649376" PTYPE="4" WIDTH="358.235089473684" HEIGHT="216.336" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L358.235 0 L358.235 216.336 L0 216.336 L0 0 Z" copath="M0 0 L358.235 0 L358.235 216.336 L0 216.336 L0 0 Z" gXpos="114.660910526316" gYpos="248.247999999987" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Daniel Yin"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Basically at the beach "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT CH="    In a rare stretch of good weather, Carnegie Mellon students have taken it upon themselves to spend their limited free time &quot;touching grass.&quot; Although students largely found going outside to be enjoyable, CMU's administration identified several insidious drawbacks of the practice. As a result, the university coated the most popular lounging areas, the Cut and the Mall, with a layer of silt."/>
                <para/>
                <ITEXT CH="    The administration often uses days with nice weather for promotional photos of campus, which could be adversely affected by the presence of students. University Communications and Marketing research has shown that the presence of students lying down in the grass is harmful to CMU's rigorous reputation. The yellow-brown dust caked in the grass will proudly be featured in UCM materials. "/>
                <para/>
                <ITEXT CH="    Another harm brought about by resting and relaxing is to students' mental health. Fewer students reported going to CaPS, which made appointments more available. This may lead students to believe the help they receive is less selective and thus worse in quality, impacting therapy outcomes. The university hopes the layer of sediment will raise wait times to a target 8 weeks for a first appointment. "/>
                <para/>
                <ITEXT CH="    We reached out to Scotty’s spokesperson about the new lawn treatment. He reported: “It’s no substitute for delicious manure, but the mud-like texture of the silt mixing with the sprinkler water makes for a fun afternoon for Scotty.”"/>
                <para/>
                <ITEXT CH="    Overall, the benefits of making the grass look and feel like it's covered in cow dung is estimated to improve student sentiment to an &quot;acceptable&quot; level and save about 20% as much as it cost."/>
                <para/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="458.185628571429" YPOS="865.98537142857" OwnPage="1" ItemID="187436896" PTYPE="2" WIDTH="240.815171428571" HEIGHT="311.35862857143" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" TEXTFLOWMODE="1" LOCALSCX="0.1887021991342" LOCALSCY="0.1887021991342" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="Finals Scream.png" IRENDER="0" EMBEDDED="0" path="M0 0 L240.815 0 L240.815 311.359 L0 311.359 L0 0 Z" copath="M0 0 L240.815 0 L240.815 311.359 L0 311.359 L0 0 Z" gXpos="458.185628571429" gYpos="-2462.01782857143" gWidth="66.7553808526368" gHeight="95.4643" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="180.3742" YPOS="1630.3568" OwnPage="1" ItemID="187439728" PTYPE="6" WIDTH="341.6266" HEIGHT="13.6479999999997" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PCOLOR="White" PLINEART="1" path="M0 0 L341.627 0 L341.627 13.648 L0 13.648 L0 0 Z" copath="M0 0 L341.627 0 L341.627 13.648 L0 13.648 L0 0 Z" gXpos="180.3742" gYpos="2462.36" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="849.6242" YPOS="1115.1843" OwnPage="-1" ItemID="187442560" PTYPE="2" WIDTH="232.0625" HEIGHT="397.062100000001" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="0.24" LOCALSCY="0.24" LOCALX="-72" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" Pagenumber="0" PFILE="../OneDrive/Documents/GitHub/readme-layout/Vol5/5.6 Readme - Scotty Doesn't Know/5.5 images/How to Deal with Those Fuckass Scooters.png" IRENDER="0" EMBEDDED="0" path="M0 0 L232.062 0 L232.062 397.062 L0 397.062 L0 0 Z" copath="M0 0 L232.062 0 L232.062 397.062 L0 397.062 L0 0 Z" gXpos="849.6242" gYpos="1947.1875" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="476.0008" YPOS="149.32010393701" OwnPage="0" ItemID="187445392" PTYPE="4" WIDTH="221.2632" HEIGHT="63.61589606299" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L221.263 0 L221.263 63.6159 L0 63.6159 L0 0 Z" copath="M0 0 L221.265 0 L221.265 63.616 L0 63.616 L0 0 Z" gXpos="476.0008" gYpos="149.32010393701" gWidth="282.55" gHeight="45.4146798798563" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
