                <ITEXT CH="What is Luigi Mangione"/>
                <para ALIGN="1"/>
                <ITEXT CH="up to these days?"/>
                <trail ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="113.660910526316" YPOS="539.248" OwnPage="0" ItemID="190353536" PTYPE="4" WIDTH="358.235089473684" HEIGHT="47.232" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L358.235 0 L358.235 47.232 L0 47.232 L0 0 Z" copath="M0 0 L358.235 0 L358.235 47.232 L0 47.232 L0 0 Z" gXpos="113.660910526316" gYpos="539.247999999987" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Citron"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Tapped into the celebrity lifestyle "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para/>
                <ITEXT CH="    He's in prison."/>
                <para/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
