        </PAGEOBJECT>
        <PAGEOBJECT XPOS="476.0008" YPOS="218.36" OwnPage="0" ItemID="187448224" PTYPE="4" WIDTH="220.6872" HEIGHT="484.416" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L220.687 0 L220.687 484.416 L0 484.416 L0 0 Z" copath="M0 0 L220.687 0 L220.687 484.416 L0 484.416 L0 0 Z" gXpos="476.0008" gYpos="218.359999999987" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Violet R. Blu"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="aka Ezra Dolla $ign "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para ALIGN="1"/>
                <ITEXT CH="As I enter the cold concrete cervix of Wean,"/>
                <para ALIGN="1"/>
                <ITEXT CH="the gold plaque of Raymond smells my fear."/>
                <para ALIGN="1"/>
                <ITEXT CH="I order a coffee that’ll make me shit"/>
                <para ALIGN="1"/>
                <ITEXT CH="out all my self-loathing and lack of sleep."/>
                <para ALIGN="1"/>
                <ITEXT CH="I don’t think I’ve retained a thing from this class."/>
                <para ALIGN="1"/>
                <ITEXT CH="It might be worth risking the AIV."/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <ITEXT CH="Is channeling ghosts in exams an AIV?"/>
                <para ALIGN="1"/>
                <ITEXT CH="I’ll hash out my questions with Raymond John Wean."/>
                <para ALIGN="1"/>
                <ITEXT CH="I’m not sure if he can help with this class,"/>
                <para ALIGN="1"/>
                <ITEXT CH="but my judgment is clouded by fear."/>
                <para ALIGN="1"/>
                <ITEXT CH="As quietly as if the world were asleep,"/>
                <para ALIGN="1"/>
                <ITEXT CH="I whisper a refrain of Shit, shit, shit."/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <ITEXT CH="I come to the conclusion that I’m shit"/>
                <para ALIGN="1"/>
                <ITEXT CH="out of luck even if I get away with an AIV."/>
                <para ALIGN="1"/>
                <ITEXT CH="Though I cry myself to sleep,"/>
                <para ALIGN="1"/>
                <ITEXT CH="I know I’m not alone. We all must wean"/>
                <para ALIGN="1"/>
                <ITEXT CH="ourselves off of hope and learn to swallow fear."/>
                <para ALIGN="1"/>
                <ITEXT CH="Here’s what they missed in your Core@CMU class:"/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <ITEXT CH="We all like to think we have too much class"/>
                <para ALIGN="1"/>
                <ITEXT CH="to write answers on the bathroom wall in shit,"/>
                <para ALIGN="1"/>
                <ITEXT CH="but people grow desperate in times of fear."/>
                <para ALIGN="1"/>
                <ITEXT CH="If the big stall stinks of an AIV,"/>
                <para ALIGN="1"/>
                <ITEXT CH="pretend you saw nothing. Just walk out of Wean."/>
                <para ALIGN="1"/>
                <ITEXT CH="Don’t wake the custodial staff from their sleep."/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <ITEXT CH="Even in the depths of REM sleep,"/>
                <para ALIGN="1"/>
                <ITEXT CH="you’ll be doing work for your linalg class."/>
                <para ALIGN="1"/>
                <ITEXT CH="Each matrix is The Matrix, labyrinthine Wean,"/>
                <para ALIGN="1"/>
                <ITEXT CH="and you’ll find that you can’t escape for shit."/>
                <para ALIGN="1"/>
                <ITEXT CH="Is dreaming of vectors an AIV?"/>
                <para ALIGN="1"/>
                <ITEXT CH="Thousands of arrows all pointing to fear."/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <ITEXT CH="You have nothing to fear except not feeling fear,"/>
                <para ALIGN="1"/>
                <ITEXT CH="not studying enough, and getting too much sleep."/>
                <para ALIGN="1"/>
                <ITEXT CH="Being rested and calm is an AIV."/>
                <para ALIGN="1"/>
                <ITEXT CH="If you want to pass every class,"/>
                <para ALIGN="1"/>
                <ITEXT CH="you must sit on the toilet and shit"/>
                <para ALIGN="1"/>
                <ITEXT CH="enough bricks to build a replica of Wean."/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <ITEXT CH="Professors give lectures on fear to each class."/>
                <para ALIGN="1"/>
                <ITEXT CH="Just get some sleep! No. Ignore that shit."/>
                <para ALIGN="1"/>
                <ITEXT CH="It’s not an AIV to give your soul to Wean."/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="114.0967" YPOS="475.32010393701" OwnPage="0" ItemID="190364864" PTYPE="4" WIDTH="357.7993" HEIGHT="62.50389606299" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L357.799 0 L357.799 62.5039 L0 62.5039 L0 0 Z" copath="M0 0 L357.803 0 L357.803 62.504 L0 62.504 L0 0 Z" gXpos="114.0967" gYpos="475.32010393701" gWidth="282.55" gHeight="45.4146798798563" ALIGN="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
