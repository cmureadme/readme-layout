        <PAGEOBJECT XPOS="540.56892283918" YPOS="732.772638444997" OwnPage="0" ItemID="190373360" PTYPE="6" WIDTH="34.6493700438005" HEIGHT="38.4729956165456" FRTYPE="7" CLIPEDIT="1" PWIDTH="1" PCOLOR2="Black" PLINEART="1" path="M0 9.61825 L17.3247 9.61825 L17.3247 0 L34.6494 19.2366 L17.3247 38.473 L17.3247 28.8548 L0 28.8548 L0 9.61825 Z" copath="M-9.21524 0 L-9.21524 18.0823 L0 18.0823 L-18.4305 36.1646 L-36.861 18.0823 L-27.6457 18.0823 L-27.6457 0 L-9.21524 0 Z" gXpos="540.56892283918" gYpos="-99.230561555003" gWidth="34.6493700438005" gHeight="38.4729956165456" LAYER="0"/>
