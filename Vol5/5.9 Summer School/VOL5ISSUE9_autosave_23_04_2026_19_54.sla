        <PAGEOBJECT XPOS="404.4992" YPOS="2873.9456" OwnPage="3" ItemID="265635760" PTYPE="4" WIDTH="293.625" HEIGHT="68.6879999999999" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L293.625 0 L293.625 68.688 L0 68.688 L0 0 Z" copath="M0 0 L293.624 0 L293.624 68.6878 L0 68.6878 L0 0 Z" gXpos="404.4992" gYpos="377.936" gWidth="282.55" gHeight="45.4146798798563" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="1" LINESP="32" FONT="Special Elite Regular" FONTSIZE="33" SCALEH="90" KERN="-6"/>
                <ITEXT CH="Readme's Homework-Eating Service"/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="403.3742" YPOS="2944.125" OwnPage="3" ItemID="265649920" PTYPE="4" WIDTH="294.75" HEIGHT="350.575" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="8" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L294.75 0 L294.75 350.575 L0 350.575 L0 0 Z" copath="M0 0 L294.75 0 L294.75 350.575 L0 350.575 L0 0 Z" gXpos="916.5598" gYpos="1004.66259999999" gWidth="0" gHeight="0" PSTYLE="Default Paragraph Style" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle PARENT="Default Paragraph Style" LINESP="10" FONT="Bell MT Regular" FONTSIZE="9" KERN="0" LANGUAGE="en_US"/>
                <ITEXT FONT="Bell MT Bold" FONTSIZE="9" CH="Gilgamesh Ichthyomorphosis"/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Nom Nom "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <para PARENT="Default Paragraph Style" LINESP="10"/>
                <ITEXT CH="    Finals are a stressful time. Each class just loves piling on projects, homework, and exams all at once. "/>
                <para/>
                <ITEXT CH="    That's why Readme is proud to introduce the new Readme Homework Eating Service! Inspired by the dogs of old, the Readme Homework Eating Service is incredibly straightforward. Bring a printed out copy of your homework to any member of Readme and they will promptly eat it. If your homework is digital, we are happy to accommodate by consuming your laptop or tablet."/>
                <para/>
                <ITEXT CH="    If your professor requires proof of why you couldn’t complete your homework, simply take a picture of a member of the Readme Homework Eating Service gnawing on your work. We are also happy to pose for action shots of you watching helplessly as a member of Readme viciously consumes your assignment."/>
                <para/>
                <para/>
                <ITEXT FONT="Bell MT Italic" CH="Testimonials:"/>
                <para/>
                <ITEXT CH="    “I was really stressed out about my First Year Writing paper. Thankfully, a member of Readme ate the entirety of my rough draft! Now I no longer need to think about it. The bite marks were so dog-like that my professor just stood in shock! Thanks, Readme Homework Service!”"/>
                <para/>
                <ITEXT CH="    “15-122 just kept giving me programming homework, and I didn’t know how to complete any of them. So, I brought my laptop to the Readme Homework Eating Service, and they went to town. I’m a bit concerned about their willingness to eat electrical components, but at least I’m now free of 122.”"/>
                <para/>
                <ITEXT CH="    “I’m a TA for [REDACTED] and I really didn’t want to grade the finals. I brought a stack of finals to the Readme Homework Eating Service, and they ate them all for me. I’m probably going to get fired, but at least I don’t have to grade these finals.”"/>
                <para/>
                <ITEXT CH="    “I was worried that my tear-stained dissertation wouldn’t be edible, but the guys at the Readme Homework Eating Service seemed to really enjoy it. I think they liked the slightly salty taste.”"/>
                <para/>
                <ITEXT CH="    “I’m a professor for [REDACTED], and I didn’t feel like teaching. I gave Readme my class notes and they consumed all of them for me. Fuck you, I have tenure.”"/>
                <para/>
                <ITEXT FONT="Bell MT Italic" CH="Note: Please remove all staples from papers before turning them over to the Readme Homework Eating Service. (One of our employees likes the staples a little too much.)"/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="313.6376" YPOS="2038.7" OwnPage="2" ItemID="265638592" PTYPE="2" WIDTH="89.0865999999999" HEIGHT="86.6750000000002" RADRECT="43.3375000000001" FRTYPE="2" CLIPEDIT="0" PWIDTH="1" PCOLOR2="Black" PLINEART="37" LOCALSCX="0.225716145833334" LOCALSCY="0.225716145833334" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="0" RATIO="1" Pagenumber="0" PFILE="../../relevant_images/Readme_logo_attempt_-_base_layer_Original.png" PRFILE="Embedded sRGB built-in" IRENDER="0" EPROF="Embedded sRGB built-in" NUMDASH="2" DASHS="0.1 0.1 " DASHOFF="0" path="M0 43.3375 C0 19.4029 19.4029 0 43.3375 0 L45.7491 0 C69.6837 0 89.0866 19.4029 89.0866 43.3375 C89.0866 67.2721 69.6837 86.675 45.7491 86.675 L43.3375 86.675 C19.4029 86.675 0 67.2721 0 43.3375 Z" copath="M0 36.9534 C0 16.5446 16.5446 0 36.9534 0 L52.1332 0 C72.542 0 89.0866 16.5446 89.0866 36.9534 L89.0866 49.7216 C89.0866 70.1304 72.542 86.675 52.1332 86.675 L36.9534 86.675 C16.5446 86.675 0 70.1304 0 49.7216 L0 36.9534 Z" ImageRes="2" gXpos="313.6376" gYpos="3702.7032" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1"/>
        <PAGEOBJECT XPOS="124.3242" YPOS="2042.19108571429" OwnPage="2" ItemID="265658416" PTYPE="4" WIDTH="119.05" HEIGHT="82.0401642857096" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L119.05 0 L119.05 82.0402 L0 82.0402 L0 0 Z" copath="M0 0 L119.05 0 L119.05 82.0397 L0 82.0397 L0 0 Z" gXpos="124.3242" gYpos="4538.19428571429" gWidth="148.791424346969" gHeight="91.0679" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="1" LINESP="10" ParagraphEffectOffset="0" ParagraphEffectIndent="0" DROP="0" Bullet="0" BulletStr="•" Numeration="0" FONT="Bell MT Regular" FONTSIZE="9"/>
                <ITEXT FONT="Bell MT Regular" FONTSIZE="9" CH="Bored? Single? Looking for love at Carnegie Mellon? Forget that, come write satire for readme! No experience required or requested. We're always looking for clowns, funny guys, smart-alecks, layout artists, "/>
                <ITEXT CH="and a way out."/>
                <para ALIGN="1" LINESP="10"/>
            </StoryText>
        </PAGEOBJECT>
