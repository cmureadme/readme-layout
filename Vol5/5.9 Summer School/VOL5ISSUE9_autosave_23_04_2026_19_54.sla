        <PAGEOBJECT XPOS="113.5008" YPOS="2530.1048" OwnPage="3" ItemID="187465728" PTYPE="2" WIDTH="246.898" HEIGHT="386.5202" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PCOLOR2="Black" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="-782.499999999999" LOCALY="-261.25" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" PRFILE="sRGB display profile (ICC v2.2)" IRENDER="0" path="M0 0 L246.898 0 L246.898 386.52 L0 386.52 L0 0 Z" copath="M0 0 L246.896 0 L246.896 386.524 L0 386.524 L0 0 Z" ImageRes="2" gXpos="113.5008" gYpos="2530.1048" gWidth="246.898" gHeight="379.394967854048" GRExtM="3" GRTYPM="2" GRSTARTXM="0" GRSTARTYM="0" GRENDXM="337.087838028064" GRENDYM="0" GRFOCALXM="0" GRFOCALYM="0" GRSCALEM="1" GRSKEWM="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <M_CSTOP RAMP="0" NAME="Black" SHADE="100" TRANS="1"/>
            <M_CSTOP RAMP="1" NAME="Black" SHADE="100" TRANS="1"/>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="113.8744" YPOS="1801.125" OwnPage="2" ItemID="180872176" PTYPE="4" WIDTH="276.7498" HEIGHT="235.125" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="2" COLGAP="7.2" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L276.75 0 L276.75 235.125 L0 235.125 L0 0 Z" copath="M0 0 L276.75 0 L276.75 235.125 L0 235.125 L0 0 Z" gXpos="113.8744" gYpos="1801.125" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESP="10" FONT="Bell MT Regular" FONTSIZE="9"/>
                <ITEXT FONT="Bell MT Bold" CH="Raytheon Blues"/>
                <para ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" CH="On the Bus Ride to Heaven"/>
                <para ALIGN="1" LINESP="10"/>
                <para ALIGN="0" LINESP="10"/>
                <ITEXT CH="    Yeah, I know she’s unpopular."/>
                <para/>
                <ITEXT CH="    I know you want your analog methods back. This is like the NYC Metro card all over for you, huh? Well, I don’t care. I’m in love, and I’m proud of it. "/>
                <para/>
                <ITEXT CH="    Me and the Ready 2 Ride Mobile app met on the way to the coffee shop. Everybody wants something purely physical these days. Well, I downloaded her at the last second—I know, pretty lame of me. We were ships crossing in the night, I could only activate the ticket right before the ride. But once we were in transit together, I couldn’t look away. "/>
                <para/>
                <ITEXT CH="    Ready 2 Ride, your beauty is not the kind that most people can understand. Everyone wants the raw pain of having to change the cards’ orientation to no avail. But with you, there is a deeper struggle—the struggle to be known. It took me shockingly long to convince you that I was even a CMU student, and, even then, the trust was thin. "/>
                <para/>
                <ITEXT CH="    But as we’ve gotten to know each other in these very short days, I’ve learned a lot about you. Yeah, you like having a monthly hall pass that can be activated an unlimited number of times. But I’m cool with that. I love you for who you are, Ready 2 Ride App. I don’t need you to go to the ends of the earth for me, because going to Giant Eagle will be enough. You are the center of my universe and my homescreen, the love of my life, and I love you."/>
                <para/>
                <ITEXT CH="    Ready 2 Ride App, if you put a strap on, I’m always Ready 2 Ride you."/>
                <para/>
                <para/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="113.7864" YPOS="1698.30676850394" OwnPage="2" ItemID="180877552" PTYPE="4" WIDTH="276.8378" HEIGHT="100.97323149606" FRTYPE="0" CLIPEDIT="1" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L276.838 0 L276.838 100.973 L0 100.973 L0 0 Z" copath="M0 0 L276.837 0 L276.837 100.973 L0 100.973 L0 0 Z" gXpos="113.7864" gYpos="1698.30676850394" gWidth="282.55" gHeight="45.4146798798563" ALIGN="1" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle ALIGN="1" LINESP="32" FONT="Special Elite Regular" FONTSIZE="33" SCALEH="90" KERN="-6"/>
                <ITEXT CH="My Relationship "/>
                <para/>
                <ITEXT CH="with the Ready 2 Ride Mobile App"/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
