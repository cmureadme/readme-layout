                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
                <ITEXT FONT="Bell MT Italic" FONTSIZE="9" KERN="0" CH="Tapped into the celebrity lifestyle "/>
                <para PARENT="Default Paragraph Style" ALIGN="1" LINESP="10"/>
